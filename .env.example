# Google Gemini API credential (Free Tier supported for eligible projects)
GEMINI_API_KEY=

# AquaMind optional LLM reasoning layer
AQUAMIND_LLM_ENABLED=false
AQUAMIND_LLM_MODEL=gemini-3.5-flash-lite

# Paid-tier reference pricing verified 2026-10-26 (USD per 1M tokens).
# The published Gemini Free Tier token price is $0.00 while requests remain
# within the Free Tier limits. These paid-tier rates are used by AquaMind's
# conservative budget preflight and for scaling projections.
# Re-check https://ai.google.dev/gemini-api/docs/pricing before deployment.
AQUAMIND_LLM_INPUT_PER_MILLION_USD=0.30
AQUAMIND_LLM_CACHED_INPUT_PER_MILLION_USD=0.03
AQUAMIND_LLM_OUTPUT_PER_MILLION_USD=2.50

# Runtime safety / cost controls
AQUAMIND_LLM_MAX_OUTPUT_TOKENS=160
AQUAMIND_LLM_PREFLIGHT_INPUT_TOKENS=6000
AQUAMIND_TASK_BUDGET_USD=0.10

# Cost-analysis labeling. Keep "free" only when the project is actually using
# Google's Free Tier; verify your project in Google AI Studio before production deployment.
AQUAMIND_GEMINI_USAGE_TIER=free
